# Copy this file to .env and fill in real values. Never commit .env.

# ---- MySQL (primary runtime database — required) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=traffic_app
DB_PASSWORD=changeme
DB_NAME=chennai_traffic

# ---- Services ----
ML_SERVICE_URL=http://localhost:8000
PORT=4000

# If true, the backend will run schema+seed automatically on startup.
# Leave false in normal use; run `npm run db:init` manually instead.
AUTO_SEED_ON_START=false

DEMO_MODE=true
